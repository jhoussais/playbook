
options {
    listen-on port 53 { any; };
    listen-on-v6 port 53 { any; };

    directory "/var/named";

    allow-query { localhost; 10.84.200.0/24; };
    recursion yes;

    forwarders {
{% for dns in bind_forwarders %}
        {{ dns }};
{% endfor %}
    };

    forward only;

    dnssec-validation auto;
};

include "/etc/named.rfc1912.zones";
include "/etc/named.root.key";
